#include "resource.h"
#include <windows.h>

IDI_APPICON ICON DISCARDABLE "clipkeeper.ico"

// 版本块。Explorer 的属性页和一切安装包检查工具读的都是它，没有它这个 exe 报不出版本
// ——而它是要随 WindowMark 装到用户机器上的，排障时「你装的是哪一版」得答得出来。
//
// 这里的版本**不跟 WindowMark 走**：ClipKeeper 是独立的 exe，有自己的演进节奏，硬拉到
// 0.4.x 只会让人以为两者同源同步。所以也不接 WindowMark 那套 configure_file 版本注入，
// 就写在这里，改的时候两行一起改。
1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 040904b0 = US English, Unicode。语言 id 描述的是代码页，不是文案语言；
        // 面向用户的字符串该是中文就是中文。
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "yekoye"
            VALUE "FileDescription",  "ClipKeeper - 剪贴板守护"
            VALUE "FileVersion",      "0.1.0"
            VALUE "InternalName",     "ClipKeeper"
            VALUE "OriginalFilename", "ClipKeeper.exe"
            VALUE "LegalCopyright",   "yekoye"
            VALUE "ProductName",      "ClipKeeper"
            VALUE "ProductVersion",   "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
